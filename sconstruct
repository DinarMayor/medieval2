#called by CreateDemoInstaller
def CreateDemoInstallerEx(project, release, target):

    folder = os.getcwd()
    os.chdir(os.path.join(r'.\installers',project))

    res = AdjustISM(project+'.ism', folder, '')
    if res != 0:
        os.chdir(folder)
        return res

    # build skin
    if os.path.exists(r'.\skin') :
        print 'Building skin ...'
        res = env.Execute(r'..\tools\isskintool\CreateSkinFile.exe .\skin setup.isn')
        print '\n'
        if res == 0:
            os.chdir(folder)
            return res

    # build media
    cmd = r'"%s" -p "%s" -r "%s"' % (ISCmdBuild, project+'.ism', release)
    if Debug:
        print cmd
    res = 0
    res = env.Execute(cmd)
    if res != 0:
        os.chdir(folder)
        return res

    # copy skin
    if os.path.exists(r'.\setup.isn') :
        print 'Replacing skin ...'
        try:
            shutil.copyfile(r'.\setup.isn', r'.\%s\Media\%s\Disk Images\Disk1\setup.isn' % (project, release))
            print 'Done.'
        except:
            print 'Error: cannot copy skin'

    os.chdir(folder)

    # pack to selfextract exe
    targetFolder = os.path.join(artifactsDir, 'installer')
    EnsureFolder(targetFolder)
    cmd = r'"%s" ".\installers\%s\%s\Media\%s\Disk Images" "%s" "%s" 0' % (ISPacker, project, project, release, os.path.join(targetFolder, target), os.path.join(folder, r'bin\medieval2.exe'))
    if Debug:
        print cmd
    res = 0
    res = env.Execute(cmd)
    if res != 0:
        os.chdir(folder)
        return res

    os.chdir(folder)
    return 0

