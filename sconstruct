def NLBuilder_GameDiff(args):

    print ' '
    print '============================================='   
    print 'NLBuilder_GameDiff called'
    print '=============================================' 

    # use the first sku language specified as the reference for non localised diffs
    prevLanguage = globals()["LanguageId"]
    languages = SKULanguages[globals()["SKUIndex"]][1]
    globals()["LanguageId"] = languages[0]
        
    EnsureArtifactsFolder()
         
    # setup destination diff folder
    targetDir = os.path.join(os.getcwd(), r'Diffs\Non Localised\Patch')
    
    # remove any existing diffs
    shutil.rmtree(targetDir, True)
    
    # create the folder
    EnsureFolder(targetDir)

    #diff the folders
    for folder, options in FoldersToDiffNL:
        print 'Creating diffs for [%s] with options [%s]' % (folder, options)
        
        res = CreateDiffs(targetDir, folder, options)
        if res != 0:
            globals()["LanguageId"] = prevLanguage
            return res    
    
    globals()["LanguageId"] = prevLanguage
    return 0
    
