#Obsolete    
def PublishDataPacks():

    root    = os.path.abspath('.')
    res = re.compile('(?P<id>.*)-[0-9]*').match(buildVersion)
    if res :
        buildName = res.group('id')
    else:
        buildName = buildVersion
    copy2   = '\\\\ZEPPELIN\\DataCache\\'+buildName

    def clear_ro(where) :
        for path, dirs, files in os.walk(where) :
            for f in files:
                os.chmod(os.path.join(path, f), stat.S_IWRITE)

    def clear(what) :
        clear_ro(what)
        try:    shutil.rmtree(what, 1)
        except: return 0
        return 1

    def clear_old(where) :
        flist = []
        for f in os.listdir(where):
            pathname = os.path.join(where, f)
            if stat.S_ISDIR(os.stat(pathname)[stat.ST_MODE]):
                flist.append(f)
        flist.sort()
        while len(flist) > 10 :
            clear(os.path.join(where, flist.pop(0)))

    def do_copy(where) :
        exts    = ['.dat', '.idx', '.cur', '.ani']
        folders = ['animations', 'sounds', 'cursors']

        try:
            for folder in folders :
                fname = os.path.join(where, 'data', folder)
                if not os.path.exists(fname):
                    os.makedirs(fname)
        except:
            print 'cannot create destination folders'
            return 0

        for folder in folders :
            print 'copying', folder, '...',
            for path, dirs, files in os.walk(os.path.join(root, 'data', folder)) :
                for f in files :
                    (fname, fext) = os.path.splitext(f.lower())
                    if fext in exts :
                        f_src = os.path.join(path, f)
                        f_dst = os.path.join(where, 'data', folder, f)
                        #print 'copying file ', f_src, 'to', f_dst,
                        try:
                            shutil.copyfile(f_src, f_dst)
                            #print 'ok'
                        except :
                            print 'error'
                            return 0
            print 'ok'
        try :
            print 'copying fmv ...',
            shutil.copytree(os.path.join(root, 'data', 'fmv'), os.path.join(where, 'data', 'fmv'))
        except:
            print 'error'
            return 0
        print 'ok'
        try :
            print 'copying packs ...',
            shutil.copytree(os.path.join(root, 'packs'), os.path.join(where, 'packs'))
        except:
            print 'error'
            return 0
        print 'ok'

        return 1

    if os.path.exists(copy2) :
        clear_old(copy2)

    if buildNumber :
        copy2 = copy2 + '\\' + str(buildNumber)
    else:
        copy2 = copy2 + r'\unknown'

    if clear(copy2) :
        if do_copy(copy2) :
            clear_ro(copy2)
            return 0
        else:
            clear(copy2)

    return 1

def SendEmail(log):
    temp = 'temp.html'
    Log2HTML(log,temp,BuildLogFormatting)
    print "Sending email..."
    me = 'buildmonkey@creative-assembly.com.au'
    to = 'callsop@creative-assembly.com.au'
    f = open(temp)
    msg = email.message_from_file(f)
    f.close()
    msg['Subject'] = 'Build: ' % buildVersion
    msg['From'] = me
    msg['To'] = to
    #msg.preamble = 'testing'
    msg.epilogue = ''
    msg.set_type('text/HTML')
    try:
        s = smtplib.SMTP()
        s.set_debuglevel(3)
        s.connect('santana')
        s.sendmail(me, to, msg.as_string())
        s.close()
    except:
        print 'error'
        return 0
    print 'ok'
    return 0

def SendEmailTest():
    SendEmail('build_log.txt')
    return 0

def PublishBuild():

    build_folder = os.path.join(buildRepository, buildVersion)
    print "  new build folder: '%s'" % build_folder

    if os.path.exists(build_folder):
        print "  removing the existing folder..."
        shutil.rmtree(build_folder)

    shutil.copytree(artifactsDir, build_folder)

    for f in ('build_log.txt', 'revision_log.txt'):
        log_file = os.path.join(publishDir, f)
        if (os.path.exists(log_file)):
            shutil.copyfile(log_file, os.path.join(build_folder, f))

    log_file = os.path.join(publishDir, 'build_log.txt')
    SendEmail(log_file)
    return 0

#------------------------------------------------------------------------------
#Localisation helpers (not mod aware)
BackupRoot          = r'.\temp\backup'
LocalizationRoot    = r'localization'
VoiceRoot           = r'data\sounds\Voice\Human\Localized'

def CleanupFolder(top):
    print ' '
    print '============================================='
    print 'CleanupFolder called, top = %s' % (top)
    print '============================================='    
    for root, dirs, files in os.walk(top, topdown=False):
        for name in files:
            f = os.path.join(root, name)
            os.chmod(f, stat.S_IWRITE)
            os.remove(f)
        for name in dirs:
            os.rmdir(os.path.join(root, name))

#------------------------------------------------------------------------------
            
def CopyLanguageAssets():

    print ' '
    print '============================================='
    print '%s CopyLanguageAssets called, LocalizationRoot = %s' % (Language, LocalizationRoot)
    print '============================================='             
    
    if not Language:
        print 'called with Language = None (LanguageID = %s), no assets copied' % LanguageId
        return None
    
    language_root = os.path.join(LocalizationRoot, Language)
        
    #update language root if building a mod
    if ModBuild:
        language_root = os.path.join(modPath, LocalizationRoot)
        language_root = os.path.join(language_root, Language)
        
    print 'language_root = %s' % language_root
    
    if not os.path.exists(language_root):
        print "Language '%s' does not exist!" % Language
        return None
    
    backup_root = os.path.join(BackupRoot, Language)
    
    #update backup root if building a mod
    if ModBuild:
        backup_root = os.path.join(modPath, backup_root)
        backup_root = os.path.join(backup_root, Language)
        
    if not os.path.exists(backup_root):
        os.makedirs(backup_root)
        
    voice_src = os.path.join(language_root, VoiceRoot)
    voice_dst = VoiceRoot
    
    #update voice root if building a mod
    if ModBuild:
        voice_dst = os.path.join(modPath, voice_dst)
        
    print 'VoiceSrc = %s' % voice_src
    print 'VoiceDst = %s' % voice_dst

    assets = {}

    # Special case: we always backup the entire voice folder!
    if os.path.exists(voice_src):
        print r"  installing Voice from %s to %s" % (voice_src, voice_dst)

        backup = os.path.join(backup_root, voice_dst)

        if os.path.exists(voice_dst):
            os.renames(voice_dst, backup)
        if os.path.exists(voice_src):
            os.renames(voice_src, voice_dst)
    else:
        print r"  WARNING: path %s does not exist" % voice_src

    # scan the language folder and move files into the root
    for root, dirs, files in os.walk(language_root):
        if not files:
            continue

        if not root.startswith(language_root):
            raise Exception, "can't interpret path %s" % root
        relative_root = root[len(language_root)+1:]

        for name in files:
            file = os.path.join(relative_root , name)
            assets[file] = 1

            original = file
            if ModBuild:
                original = os.path.join(modPath, original)
            
            backup = os.path.join(backup_root, file)
            localized = os.path.join(language_root, file)
            print r"  installing %s to %s" % (localized, original)

            if os.path.exists(original):
                os.renames(original, backup)
            os.renames(localized, original)

    return assets

#------------------------------------------------------------------------------
    
def RestoreLanguageAssets(assets):
    if not assets:
        return

    language_root = os.path.join(LocalizationRoot, Language)
    
    #update language root if building a mod
    if ModBuild:
        language_root = os.path.join(modPath, LocalizationRoot)
        language_root = os.path.join(language_root, Language)
             
    print ' '
    print '============================================='
    print '%s RestoreLanguageAssets called, language_root = %s' % (Language, language_root)
    print '============================================='              
    
    if not os.path.exists(language_root):
        os.makedirs(language_root)

    backup_root = os.path.join(BackupRoot, Language)
    
    #update backup root if building a mod
    if ModBuild:
        backup_root = os.path.join(modPath, backup_root)
        backup_root = os.path.join(backup_root, Language)

    if not os.path.exists(backup_root):
        raise Exception, "Backup '%s' does not exist!" % backup_root
        
    voice_src = os.path.join(language_root, VoiceRoot)
    voice_dst = VoiceRoot
    
    #update voice root if building a mod
    if ModBuild:
        voice_dst = os.path.join(modPath, voice_dst)

    # move the voice folder as a whole
    backup = os.path.join(backup_root, voice_dst)
    if os.path.exists(backup):
        print "  restoring Voice from %s to %s" % (backup, voice_dst)
    
        os.renames(voice_dst, voice_src)
        os.renames(backup, voice_dst)

    for file in assets.keys():
        
        original = file
        if ModBuild:
            original = os.path.join(modPath, original)
                        
        backup = os.path.join(backup_root, file)
        localized = os.path.join(language_root, file)
        
        print "  restoring %s to %s" % (backup, original)

        if os.path.exists(original):
            os.renames(original, localized)
        if os.path.exists(backup):
            os.renames(backup, original)


def CreateRetailInstall():
    res = 0

    # prepare the language assets
    if os.path.exists(BackupRoot):
        CleanupFolder(BackupRoot)

    assets = None

    try:
        assets = CopyLanguageAssets()

        # build localized pack files
        res = PacksLocalized()
        # create an installer
        if res == 0:
            res = CreateRetailInstaller()

    except Exception, ex:
        print ex
        res = 1

    # revert to English
    RestoreLanguageAssets(assets)

    return res
    
