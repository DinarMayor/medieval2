def Builder_ArchiveLocAssets(modDirs):

    print ' '
    print '============================================='
    print '%s Builder_ArchiveLocAssets called' % (LanguageId)
    print '=============================================' 
        
    #clear any existing files in destination
    destination = r'localised_assets\%s' % LanguageId
    shutil.rmtree(destination, 1)    
    
    
    #move localised game assets only, no need to move diffs as they are already localised
    locGameData  = []
    locGameData += glob.glob(r'data\sounds\*.dat')
    locGameData += glob.glob(r'data\sounds\*.idx')
    locGameData += glob.glob(r'packs\localized.pack')
    
    #move localised data
    for source in locGameData:
        
        destination = r'localised_assets\%s\%s' % (LanguageId, source)
        if os.path.exists(source):
            print "archiving localised game data from %s to %s" % (source, destination)
            os.renames(source, destination)

    #iterate over the mod directories (currently mods are new so diffs for them)
    for modDir in modDirs:
        
        #move mod game assets
        locModData  = []
        locModData += glob.glob(r'%s\data\sounds\*.dat'    % modDir)
        locModData += glob.glob(r'%s\data\sounds\*.idx'    % modDir)
        locModData += glob.glob(r'%s\packs\localized.pack' % modDir)
        
        for source in locModData:
            destination = r'.\localised_assets\%s\%s' % (LanguageId, source)
            if os.path.exists(source):
                print "archiving localised mod data from %s to %s" % (source, destination)
                os.renames(source, destination)  
        
    
    return 0
    
