#Does a data build and populates cache    
def DataBuild():
    EnsureArtifactsFolder()

    log = os.path.join(artifactsDir, 'data-build.log.txt')

    cmd = r'%sProjectConf.exe --backup' % toolsPath
    env.Execute(cmd)

    #creates a new project config file
    cmd = r'%sProjectConf.exe --create --dir="%s" --name="%s"' % (toolsPath, os.getcwd(), 'scons-mtw2-build')
    env.Execute(cmd)
            
    #.buildCache builds cache on server but doesn't necessarily check cache
    #.nocache forces dataConverter to build every asset (used for retail and possibly for clean builds)
    cmd = r'%sDataConverter.exe --conv.noprompt --conv.buildCache --core.disable_dialogs --conv.verbose --conv.start=Export --log.to="%s" --log.level="* info" --conv.reportDir="%s" ' % (toolsPath, log, artifactsDir)
    if noCache:
        cmd = cmd + " --conv.nocache"
    res = env.Execute(cmd)
            
    #restores original project config
    cmd = r'%sProjectConf.exe --restore' % toolsPath
    env.Execute(cmd)

    # save the log
    if Log2HTML(log, os.path.join(artifactsDir, 'data-build-log.html'), DataLogFormatting) :
        res = 1
        
    return res
       
#------------------------------------------------------------------------------
#Same as DataBuild but can remove duplicates  
def DataBuild_Mod():
    EnsureArtifactsFolder()

    log = os.path.join(modArtifactsDir, 'data-build.log.txt')
        
    cmd = r'%sProjectConf.exe --backup' % toolsPath
    env.Execute(cmd)
            
    cmd = r'%sProjectConf.exe --create --dir="%s\%s" --name="%s"' % (toolsPath, os.getcwd(), modPath, 'scons-mtw2-build-mod-%s' % modName)
    env.Execute(cmd)

    cmd = r'%sDataConverter.exe --conv.noprompt --conv.buildCache --core.disable_dialogs --conv.verbose --conv.start=%s\Export --log.to="%s" --log.level="* info" --conv.reportDir="%s" ' % (toolsPath, modPath, log, modArtifactsDir)
    if noCache:
        cmd = cmd + " --conv.nocache"
    res = env.Execute(cmd)
        
    cmd = r'%sProjectConf.exe --restore' % toolsPath
    env.Execute(cmd)
    
    # save the log
    if Log2HTML(log, os.path.join(modArtifactsDir, 'data-build-log.html'), DataLogFormatting) :
        res = 1
        
    # remove duplicates?  Base is root data, branch is mod data.
    if RemoveDuplicates:
        log = os.path.join(modArtifactsDir, 'data-build-clean.log.txt')
        cmd = r'%sRemoveDuplicates.exe --base="%s\data" --branch="%s\%s\data" --verbosity=1 >"%s"' % (toolsPath, os.getcwd(), os.getcwd(), modPath, log)
        res = env.Execute(cmd) 

    return res

