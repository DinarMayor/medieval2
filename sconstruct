    Language        = 'English'
    LanguageId      = 'English'
    CreateLauncher('Kingdoms')
    
    return 0
    
#------------------------------------------------------------------------------

def PostBuilder_MoveAssets(InstallerPath, Languages):

    print ' '
    print '============================================='
    print 'PostBuilder_MoveAssets called - passed in Installer path %s' % InstallerPath
    print '=============================================' 

    
    # we don't want to move non-localised diffs for some languages (eg for Japanese all 
    # assets are treated as localised so no point moving NL assets - just makes installer bigger)
    ShouldMoveNLDiffs = 0
    for language in Languages:
        for nlmoveLang, nlmoveFlag in ShouldMoveNonLocFolders:
            if language == nlmoveLang:
                if nlmoveFlag == 1:
                    ShouldMoveNLDiffs = 1
    
                    
     #copy non-localised diffs
    if ShouldMoveNLDiffs == 1:
        for mod in Mods:
            source = r'Diffs\Non Localised\Patch\mods\%s' % mod
            destination = os.path.join(InstallerPath, r'Disk Images\Disk1\main\%s\Patch' % mod)
        
            if os.path.exists(source):
                EnsureFolder(destination)
                print 'copying from %s to %s' % (source, destination)
                try:
                    shutil.rmtree(destination, 1)   
                    shutil.copytree(source, destination)
                except shutil.Error, e:
                    print ('Error copying %s to %s: %s' % (source, destination, e))        
    
            
    #copy non-localised diffs and exes
    for language in Languages:
        print 'copying localisation diffs for %s' % language
        if language == 'American':
            language = 'English'
            
        for mod in Mods:
            source      = os.path.join(r'Diffs\Localised', language, 'Patch', 'mods', mod)
            destination = os.path.join(InstallerPath, r'Disk Images\Disk1\main', mod, language, 'Patch')
            
            if os.path.exists(source):
                EnsureFolder(destination)
                print 'copying from %s to %s' % (source, destination)
                try:
                    shutil.rmtree(destination, 1)   
                    shutil.copytree(source, destination)
                except shutil.Error, e:
                    print ('Error copying %s to %s: %s' % (source, destination, e))

    # copy modified world data files
    for mod in Mods:
        folder = os.getcwd()
        source      = os.path.join(folder, 'mods', mod, 'data', 'world')
        reference   = os.path.join(folder, ReferenceVersion, Languages[0], 'mods', mod, 'data', 'world')
        destination = os.path.join(folder, InstallerPath, r'Disk Images\Disk1\main', mod, 'world')
        
        print '============================================='
        print '    World Files: source = %s' % source
        print '    World Files: reference = %s' % reference
        print '    World Files: destination = %s' % destination
        print '============================================='
       
        os.chdir(source)
    
        for root, dirs, files  in os.walk('.'):
            for f in files:
                # compare against reference
                s = os.path.join(source, root, f)
                r = os.path.join(reference, root, f)
                
                if not os.path.exists(r) or not filecmp.cmp(s, r, False):
                    # copy into destination
                    d = os.path.join(destination, root, f)
                    targetPath = os.path.join(destination, root)
                                            
                    print 'copying from %s to %s (target path = %s, reference file = %s)' % (s, d, targetPath, r)
                    EnsureFolder(targetPath)
                    try:
                        shutil.copyfile(s, d)
                    except shutil.Error, e:
                        print ('Error copying %s to %s: %s' % (source, destination, e))
                            
        os.chdir(folder)
    return 0
    
#------------------------------------------------------------------------------

def PostBuilder_Kingdoms_Installer(installers):

    global Language, LanguageId

    print ' '
    print '============================================='
    print '%s PostBuilder_Kingdoms_Installer called.  Product code is %s, distribution source is %s' % (Language, ProductCode, DistribSource)
    print '=============================================' 
    
    EnsureArtifactsFolder()
    
    ret = 0
    
    #build the InstallShield library
    ret = BuildISLib()
    if ret != 0:
         return ret

    count = 0
    for installer, project, languages in installers:
        count = count + 1
        
        for installerLan in languages:
            targetDir = artifactsDir
            LanguageId = installerLan
            if installerLan == 'English':
                Language = None
            else:
                Language = installerLan
                
            english  = r'localised_assets\English'
            american = r'localised_assets\American'
            backup   = os.path.join(BackupRoot, english)                
         
            assets = CopyLanguageAssets()
                   
            if installerLan == 'American':
            
                # American is not a seperate language so we trick the installers into thinking it is English
                print 'Switching English localised_assets for American'
                
                if os.path.exists(backup):
                    shutil.rmtree(backup)              
            
                if os.path.exists(english):
                    print 'renaming %s to %s' % (english, backup)
                    os.renames(english, backup)
                print 'renaming %s to %s' % (american, english)
                os.renames(american, english)      
                
                targetDir = os.path.join(targetDir, Language)
                Language  = 'English'
            
            # build the installer, the target directory is the language but for Steam, D2D and DR we have to use the dstsrc else they will overwrite the last English build
            targetDir   = os.path.join(targetDir, project)
            targetDir   = os.path.join(targetDir, installer)
            lessDistSrc = targetDir
            if DistribSource != '':
                targetDir = os.path.join(targetDir, DistribSource)
            ret = CreateInstallerEx(installer, project, targetDir, releaseVersion, ProductCode, DistribSource)
            if ret:
               return ret
               
            
            tokens  = installer.split('_')
            name    = tokens[0]
            
            # bit of a hack, expects 'kingdoms' 'kingdoms_teutonic' etc, will fall in below only for 'kingdoms'
            print 'comparing %s to %s' % (name, installer)
            if name == installer:
                ret = PostBuilder_Kingdoms_MoveInstallers(project, lessDistSrc)           
                if ret:
                   return ret    
                   
            Language = installerLan   # restore English override to American so restore selects correct backup dir
            
            # Restore English backup
            if installerLan == 'American':
                if os.path.exists(backup):
                    os.renames(english, american)
                    os.renames(backup, english)
                
            RestoreLanguageAssets(assets)    
            
    
    return ret    
    
#------------------------------------------------------------------------------

def PostBuilder_Kingdoms_MoveInstallers(Project, InstallerPath):

    print ' '
    print '============================================='
    print 'PostBuilder_Kingdoms_MoveAssets called - passed in Installer path %s and project %s' % (InstallerPath, Project)
    print '=============================================' 

    tokens  = Project.split('_')
    project = tokens[0]
    
    # copy in update 2
    src = os.path.join(os.path.join(os.path.join(Update2, project + r'_1_02\patch_universal'), DistribSource), r'Disk Images\Disk1')
    dst = os.path.join(os.path.join(InstallerPath, DistribSource), r'Disk Images\Disk1\Update2')
    CopyDirectory(src, dst)
        
    # copy in update 3
    src = os.path.join(os.path.join(os.path.join(Update3, project + r'_1_02\patch_universal'), DistribSource), r'Disk Images\Disk1')
    dst = os.path.join(os.path.join(InstallerPath, DistribSource), r'Disk Images\Disk1\Update3')
    CopyDirectory(src, dst)      
    
    # copy installer pref into kingdoms
    dst = os.path.join(os.path.join(InstallerPath, DistribSource), r'Disk Images\Disk1')
    CopyDirectory(AddInstallFiles, dst)
    
    # move the americas installers
    src = os.path.join(os.path.join(InstallerPath + '_americas', DistribSource), r'Disk Images\Disk1')
    dst = os.path.join(os.path.join(InstallerPath, DistribSource), r'Disk Images\Disk1\americas')
    MoveDirectory(src, dst)
    
    # copy installer pref into americas
    CopyDirectory(AddInstallFilesMod, dst)
        
    # move the britannia installers
    src = os.path.join(os.path.join(InstallerPath + '_british_isles', DistribSource), r'Disk Images\Disk1')
    dst = os.path.join(os.path.join(InstallerPath, DistribSource), r'Disk Images\Disk1\britannia')
    MoveDirectory(src, dst)
    
    # copy installer pref into britannia
    CopyDirectory(AddInstallFilesMod, dst)
        
    # move the crusades installers
    src = os.path.join(os.path.join(InstallerPath + '_crusades', DistribSource), r'Disk Images\Disk1')
    dst = os.path.join(os.path.join(InstallerPath, DistribSource), r'Disk Images\Disk1\crusades')
    MoveDirectory(src, dst)
    
    # copy installer pref into crusades
    CopyDirectory(AddInstallFilesMod, dst)  
        
    # move the teutonic installers
    src = os.path.join(os.path.join(InstallerPath + '_teutonic', DistribSource), r'Disk Images\Disk1')
    dst = os.path.join(os.path.join(InstallerPath, DistribSource), r'Disk Images\Disk1\teutonic')
    MoveDirectory(src, dst)    
    
    # copy installer pref into teutonic
    CopyDirectory(AddInstallFilesMod, dst) 
        
    return 0   
   
    
    
    
