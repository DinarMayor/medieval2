def CreateInstallerEx(project, release, targetDir, release_version, productCode, distribSrc):

    print ' '
    print '============================================='
    print 'CreateInstallerEx called'
    print '=============================================' 

    EnsureFolder(targetDir)

    folder = os.getcwd()
    os.chdir(os.path.join(r'.\installers',project))
    
    # make ism writable
    ISMFileName = project+'.ism'
    #os.chmod(ISMFileName, 0777)


    # build skin
    if os.path.exists(r'.\skin') :
        print 'Building skin ...'
        res = env.Execute(r'..\tools\isskintool\CreateSkinFile.exe .\skin setup.isn')
        print '\n'
        if res == 0:
            os.chdir(folder)
            return res

    # set version is needed
   # if release_version != '' or productCode != '' :
    res = AdjustISM(ISMFileName, '', release_version, productCode)
    if res != 0:
        os.chdir(folder)
        return res

    # fix script
    if distribSrc != '':
        res = AdjustScript(project +'\\'+'Script Files'+'\\'+'Setup.Rul', distribSrc)
        if res != 0:
            os.chdir(folder)
            RestoreISM(project+'.ism')
            return res

    # build media
    cmd = r'"%s" -p "%s" -r "%s" -b "%s"'  % (ISCmdBuild, ISMFileName, release, os.path.join(folder,targetDir))
    if Debug:
        print cmd

        
    res = 0
    res = env.Execute(cmd)

    
    if res != 0:
        os.chdir(folder)
        return res    
    
    #restore the scripts
    #if release_version != '' or productCode != '' :
    RestoreISM(ISMFileName)
    
    if distribSrc != '':
        RestoreScript(project +'\\'+'Script Files'+'\\'+'Setup.Rul')

    os.chdir(folder)

    return 0

