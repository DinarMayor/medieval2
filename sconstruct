def Log2HTML(log, html, format) :
    EnsureArtifactsFolder()
    result = 0
    last1 = ''
    last2 = ''
    last3 = ''
    last4 = ''
    last5 = ''
    last6 = ''
    try:
        out = open(html, 'w')
        out.write('<html><body bgcolor=White><pre><font>\n')
        for line in file(log).readlines() :
            last6 = last5
            last5 = last4
            last4 = last3
            last3 = last2
            last2 = last1
            last1 = line
            for element in format :
                significance = 0
                if len(element) > 2 :
                    (pattern, colour, significance) = element
                else:
                    (pattern, colour) = element
                if pattern.search(line) :
                    out.write(last6)
                    out.write(last5)
                    out.write(last4)
                    out.write(last3)
                    out.write(last2)
                    if significance > result :
                        result = significance
                    if colour :
                        out.write('<font color=%s>' % colour)
                    out.write(line.strip())
                    if colour:
                        out.write('</font>')
                    out.write('\n')
                    last6 = ''
                    last5 = ''
                    last4 = ''
                    last3 = ''
                    last2 = ''
                    last1 = ''
                    break
        out.write('</font></pre></body></html>')
        out.close()
    except:
        reason = str(sys.exc_info()[0])
        try     : reason = str(sys.exc_info()[1])
        except  : pass
        print reason
        result = 1

    return result

def CatFile(log_file):
    f = open(log_file)
    for s in f.readlines():
        print s.strip()
    f.close()

