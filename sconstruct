def EnsureFolder(folder):
    if not os.path.exists(folder):
        os.makedirs(folder)

def EnsureArtifactsFolder(target = None, source = None, env = None):
    EnsureFolder(artifactsDir)
    
    if ModBuild:
        EnsureFolder(modArtifactsDir)

#------------------------------------------------------------------------------

def Copy(path) :
    try:
        shutil.copyfile(path, os.path.join(artifactsDir, os.path.split(path)[1]))
    except:
        print 'cannot copy', path

#------------------------------------------------------------------------------

def P4Run(cmd, input = None):
    #Two dimensional array (nested in python)
    options = ''
    opt_desc = [
        ('p4port', '-p'),
        ('p4user', '-u'),
        ('p4client', '-c'),
        ('p4passwd', '-P'),
        ]
        
    #loops through each row and gets the variable and option for each row
    for var, opt in opt_desc:
        val = globals()[var]
        if val:
            options += ' %s %s' % (opt, val)

    run = '%s %s -G %s' % (P4, options, cmd)
    if Debug:
        print "P4Run: %s" % run
    (pin, pout) = os.popen4(run, 'b')

    if input:
        marshal.dump(input, pin, 0)
    pin.close()

    res = []
    while 1:
        try:
            d = marshal.load(pout)
            res.append(d)
        except EOFError:
            break
    return res

#Comments and updates specified changelist    
def P4Changelist(descr):

    # read the form from perforce
    res = P4Run('change -o')
    if Debug:
        print 'p4 change -o :'; pprint(res)
    if res[0]['code'] == 'error':
        print 'Changelist request failed:\n  %s' % (res[0]['data'])
        return 0

    # replace the description and ditch the files section
    spec = {}
    for k in ('Change', 'Client', 'User', 'Status'):
        spec[k] = res[0][k]
    spec['Description'] = descr
    if Debug:
        print 'updated changelist :'; pprint(res)

    res = P4Run('change -i', spec)
    if Debug:
        print 'p4 change -i :'; pprint(res)
    if res[0]['code'] == 'error':
        print 'Changelist creation failed:\n  %s' % (res[0]['data'])
        return 0

    m = re.match(r'Change (\d+) created\.', res[0]['data'])
    if not m:
        print "Cannot parse p4 output"
        return 0
    changelist = int(m.group(1))
    return changelist

