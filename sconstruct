env.AlwaysBuild(packs)

publish_packs = env.Alias('publish-packs', [], lambda target, source, env : PublishDataPacks())
env.AlwaysBuild(publish_packs)

publish_build = env.Alias('publish-build', [], lambda target, source, env : PublishBuild())
env.AlwaysBuild(publish_build)

data_target = BuildData and data_build or data_convert
build = env.Alias('build', [code, data_target, packs])
env.AlwaysBuild(build)

create_installer_fn = CreateGameInstaller
if DemoBuild:
    create_installer_fn = CreateDemoInstaller
game_installer = env.Alias('installer-game', [], lambda target, source, env : create_installer_fn())
env.AlwaysBuild(game_installer)

mod_installer = env.Alias('installer-mod', [], lambda target, source, env : CreateModInstaller())
env.AlwaysBuild(mod_installer)

tools_installer = env.Alias('installer-tools', [], lambda target, source, env : CreateToolsInstaller())
env.AlwaysBuild(tools_installer)

install = env.Alias('install', [build, game_installer])
env.AlwaysBuild(install)

artbuild = env.Alias('artbuild', [tools_installer], UpdateArtBuild)
env.AlwaysBuild(artbuild)

all = env.Alias('all', [install])
env.AlwaysBuild(all)

retail_build = env.Alias('retail-build', [code, data_target, packs_game, packs_data])
env.AlwaysBuild(retail_build)

retail_install = env.Alias('retail-install', [], lambda target, source, env : CreateRetailInstall())
env.AlwaysBuild(retail_install)

retail_patch1 = env.Alias('retail-patch1', [], lambda target, source, env : CreateRetailPatch1())
env.AlwaysBuild(retail_patch1)

retail_update2_install = env.Alias('retail-update2-install', [], lambda target, source, env : CreateRetailUpdate2Install())
env.AlwaysBuild(retail_update2_install)

kingdoms_SKUs = env.Alias('kingdomsSKU', [], lambda target, source, env : CreateKingdomsSKU())
env.AlwaysBuild(kingdoms_SKUs)

code_test = env.Alias('codeTest', [], lambda target, source, env : CodeTest())
env.AlwaysBuild(code_test)

env.Default(tools)
env.Default(code)
env.Default(modTools)

testme = env.Alias('testme', [], lambda target, source, env : SendEmailTest())
env.AlwaysBuild(testme)

