#This is our day to day installer used by QA to install builds, not the release installshield
def CreateGameInstaller():
    EnsureArtifactsFolder()

    install_exe = 'MTW2-setup-%s' % buildVersion
    cmd = r'"%s" .\installers\game.iss /o"%s" /f"%s" "/dbuildVersion=%s"' % \
         (InnoSetup, os.path.join(artifactsDir, 'installer'), install_exe, buildVersion)

    if buildNumber:
        cmd += ' /dbuildNumber=%s' % buildNumber

    if installerPassword:
        cmd += ' /dinstallerPassword=%s' % installerPassword

    res = env.Execute(cmd)
    if res == 0:
        f = open(os.path.join(artifactsDir, 'installer', 'Autorun.inf'), 'w')
        f.write('[autorun]\n')
        f.write('open=%s.exe\n' % install_exe)
        f.close()

    return res

