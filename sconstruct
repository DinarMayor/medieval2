def CreateRetailUpdate2Install():
    res = 0         #0 indicates success in python

    # prepare the language assets
    if os.path.exists(BackupRoot):
        CleanupFolder(BackupRoot)

    assets = None

    try:
        assets = CopyLanguageAssets()

        # build localized pack files
        res = PacksLocalized()
        
        # create the diffs
        if res == 0:
            res = CreateRetailUpdate2Diff()
        
        # create an installer
        if res == 0:
            res = CreateRetailUpdate2Installer()

    except Exception, ex:
        print ex
        res = 1

    # revert to English
    RestoreLanguageAssets(assets)

    return res
    
