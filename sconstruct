#Generates the *.pack files located in the \Packs folder for distribution uses \util\packer.cfg
def PacksPacker():
    log_file = os.path.join(artifactsDir, 'packer.log.txt')
    res=0
    if DemoBuild:
        print "pack1"
        cmd = r'.\bin\packer.exe --config=.\util\packer-demo.cfg --verbosity 5 > %s' % log_file
        res = env.Execute(cmd)

        shutil.copyfile('./packs/data.pack', './sedata.pack')
        shutil.copyfile('./data/menu/demo.lnt', './data/menu/_demo.lnt')
        os.chmod('./data/menu/demo.lnt',stat.S_IWRITE)
        shutil.copyfile('./data/menu/demo2.lnt', './data/menu/demo.lnt')

        print "pack2"
        cmd = r'.\bin\packer.exe --config=.\util\packer-demo.cfg --verbosity 5 >> %s' % log_file
        res = env.Execute(cmd)

        shutil.copyfile('./data/menu/_demo.lnt', './data/menu/demo.lnt')
        os.chmod('./data/menu/demo.lnt',stat.S_IREAD)

    else:
        cmd = r'.\bin\packer.exe --config=.\util\packer.cfg --verbosity 5 > %s' % log_file
        res = env.Execute(cmd)
        
    return res

