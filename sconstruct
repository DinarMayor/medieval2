#Demoshield launcher on CD/DVD
def CreateLauncher(project):

    language = LanguageId
    if language == 'American':
        language = 'English'
    langId = {'English':'ENU', 'German':'DEU', 'French':'FRA', 'Italian':'ITA', 'Spanish':'ESP', 'Russian':'RUS', 'Polish':'PLK', 'Czech':'CSY', 'Japanese':'JPN', 'American':'ENU'}
    mediaDir = os.path.join(artifactsDir, LanguageId, 'Disk Images')
    targetDir = os.path.join(mediaDir, 'Disk1')
    launcherDir = os.path.join(targetDir, 'launcher')
    srcDir = r'.\installers\launcher'

    # launcher subfolder on target media
    print 'Copying launcher files into launcher subfolder...'
    EnsureFolder(launcherDir)
    for fn in ['launcher.txt', 'launcher.dbd', 'demo32.exe', 'gdiplus.dll'] :
        shutil.copyfile(os.path.join(srcDir, fn), os.path.join(launcherDir, fn))
    print "  copying Readme_Kingdoms.txt"
    shutil.copyfile(os.path.join(r'.\installers',project,'support',language,'Readme_Kingdoms.txt'), os.path.join(launcherDir, 'Readme_Kingdoms.txt'))
    print 'Done.'

    # root
    print 'Copying launcher files into the first media root...'
    if os.path.exists(os.path.join(targetDir, 'autorun.inf')) :
        os.chmod(os.path.join(targetDir, 'autorun.inf'),stat.S_IWRITE)
    srcDir =  os.path.join(srcDir, 'root')
    for fn in ['autorun.inf', 'Launch.exe', 'Launch.ini'] :
        shutil.copyfile(os.path.join(srcDir, fn), os.path.join(targetDir, fn))
    print 'Done.'

    # fix Launch.ini
    #if language != 'English':
