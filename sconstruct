#Creates the command line then uses that to kick off build
def BuildSolution(target, source, env):
    sln = str(source[0])
    cfg = env['Config']
    prj = env['Project']

    log = r'obj\build-log.txt'
    if os.path.exists(log):
        os.remove(log)

    cmd = None
    if UseIncredibuild:
        opt = Rebuild and "/rebuild" or ""

        project_string = '';        
        if prj:
            project_string = '/PRJ="%s"' % prj
        
        cmd = '"%s" "%s" %s /CFG="%s" /Log="%s" %s' % (Incredibuild, sln, opt, cfg, log, project_string)
    else:
        opt = Rebuild and "/rebuild" or "/build"

        project_string = '';        
        if prj:
            project_string = '/project "%s"' % prj
        
        cmd = '"%s" "%s" %s "%s" /out "%s" %s' % (DevEnv, sln, opt, cfg, log, project_string)

    # start building
    print '======================='
    print ' Sleep 5 before build '
    print '======================='
    time.sleep(5) # added sleep to mitigate inability to gain exclusive access to file handle
    ret = env.Execute(cmd)

    # if failed, save the log
    if ret != 0:
        print 'Build of %s failed. The return code was %d' % (str(target[0]), ret)
        
        Log2HTML(log, os.path.join(artifactsDir, 'Errors-%s.html' % (str(target[0]))), BuildLogFormatting)

    return ret

bld = env.Builder(action = BuildSolution)
env.Append(BUILDERS = {'Solution' : bld})

#------------------------------------------------------------------------------

reLabelDefine    = re.compile('define MTW2_BUILD_WATERMARK "(.*)"')
reRevisionDefine = re.compile('define MTW2_BUILD_REVISION  (.*)')


def UpdateWatermark():

    if not updateWatermark:
        return

    header = WatermarkHeader
    watermark = buildVersion
    revision = "0"

    # try to workout the last changelist synced
    d = P4Run(r'changes -m1 ...')
    if Debug:
        print 'p4 changes :'; pprint(d)
    if d[0].has_key('change'):
        revision = d[0]['change']
        watermark += ' (%s)' % revision

    # scan the file, see whether it needs updating
    update = True
    text = []
    for line in open(header).readlines():
        m = reLabelDefine.search(line)
        if m:
            update = m.group(1) != watermark
            if update:
                line = m.string[:m.start(1)] + watermark + m.string[m.end(1):]
        m = reRevisionDefine.search(line)
        if m:
            update = m.group(1) != revision
            if update:
                line = m.string[:m.start(1)] + revision + m.string[m.end(1):]
        text.append(line)

    # rewrite the file
    if update:
        print '  new watermark: "%s"' % watermark
        f = open(header, "w")
        f.writelines(text)
        f.close()

def SubmitWatermark(target, source, env):
    
    UpdateWatermark()
    
    if not submitWatermark:
        print "submitWatermark option is not set..."
        return 0

    changelist = P4Changelist("-------- %s build mark --------" % buildVersion)
    if not changelist:
        return 1
    print '  new changelist %i' % changelist

    res = P4Run(r'edit -c %i version.txt' % changelist)
    if Debug:
        print 'p4 edit version.txt :'; pprint(res)
    if res[0]['code'] == 'error':
        print 'Failed to edit :\n  %s' % (res[0]['data'])
        return 1

    if Submit:
        print '  submitting changelist %i' % changelist
        res = P4Run(r'submit -c %i' % changelist)
        if Debug:
            pprint(res)
        for r in res:
            if r['code'] == 'error':
                print 'Submitting failed:\n  %s' % (r['data'], )
                return 2

#------------------------------------------------------------------------------
#Populates the /build directory in the specified bracnh ie builds the exes for artists and design
def UpdateArtBuild(target, source, env):
    '''
    Algorithm of updating the artbuild:
      1) integrate bin into ./build
      2) update the .exe and .dll files
    '''

    changelist = P4Changelist('Art build: %s' % buildVersion)
    if not changelist:
        return 1
    print '  new changelist %i' % changelist

    def _integrate(folder, dest):
        print '  integrating %s' % folder
        res = P4Run(r'integrate -c %(changelist)i -t "%(folder)s" "%(dest)s"' % \
                {
                 'changelist':changelist,
                 'folder':folder, 'dest':dest,
                 })
        # No error checking. There might be nothing to integrate.
        if Debug:
            print '  p4 integrate : %s' % res[0]

    _integrate(r'bin\miles\...',                                    r'build\miles\...')
    _integrate(r'bin\binkw32.dll',                                  r'build\binkw32.dll')
    _integrate(r'bin\mss32.dll',                                    r'build\mss32.dll')
    _integrate(r'installers\game\...',                              r'build\...')
    
    EnsureFolder('build\Launcher')
    _integrate(r'Launcher\Launcher\Config\...',                     r'build\Launcher\Config\...')

    print '  updating executable and .dll files'
    files = [('',           r'bin\medieval2.exe'),
             ('',           r'bin\medieval2_r.exe'),
             ('',           r'bin\medieval2_d.exe'),
             ('',           r'obj\medieval2-Retail\medieval2.pdb'),
             ('',           r'obj\medieval2-Release\medieval2_r.pdb'),
             ('',           r'obj\medieval2-Debug\medieval2_d.pdb'),
             ('',           r'bin\cine.dll'),
             ('',           r'bin\cine_d.dll'),
             ('',           r'bin\cine.pdb'),
             ('',           r'bin\cine_d.pdb'),
             ('',           r'bin\IDV.dll'),
             ('',           r'bin\IDV_d.dll'),
             ('',           r'installers\tools\Output\caoz_tools_setup.exe'),
             ('\Launcher',  r'Launcher\Launcher\Bin\Launcher.exe'),
             ('\Launcher',  r'Launcher\Launcher\Bin\Launcher.pdb'),
             ('\Launcher',  r'Launcher\Launcher\Bin\AxInterop.SHDocVw.dll'),
             ('\Launcher',  r'Launcher\Launcher\Bin\Interop.SHDocVw.dll'),
             ('\Launcher',  r'Launcher\Launcher\Bin\CoreLib.dll'),
             ('\Launcher',  r'Launcher\Launcher\Bin\SkinLib.dll'),
             ('\Launcher',  r'Launcher\Launcher\Bin\UpdateLib.dll')]
    for folder, src in files:
        if Debug:
            print '    %s' % src
        if not os.path.exists(src):
            print '  executable %s does not exist' % src
            return 4

        dst = r'build%s\%s' % (folder, os.path.basename(src))
        if os.path.exists(dst):
            os.chmod(dst, 0777)     #change file attributes to make newly copied file writable
            os.remove(dst)

        def _copy(src, dst):
            try:
                shutil.copyfile(src, dst)
            except:
                print '  copy of %s to %s failed!' % (src, dst)
                return 5
            return 0

        res = P4Run(r'fstat "%s"' % dst)
        if Debug:
            pprint(res)
        if res[0]['code'] == 'stat':
            res = P4Run(r'edit -c %i -t binary+lS %s' % (changelist, dst)) #+1S tells P4 to keep only 1 revision of this binary file, ie no reverting to previous revisions.
            if Debug:
                pprint(res)
            if res[0]['code'] == 'error':
                print 'Editing %s failed:\n  %s' % (dst, res[0]['data'])
                return 2
            if _copy(src, dst) != 0:
                return 1
        else:
            if _copy(src, dst) != 0:
                return 1
            res = P4Run(r'add -c %i -t binary+lS %s' % (changelist, dst))
            if Debug:
                pprint(res)
            if res[0]['code'] == 'error':
                print 'Adding %s failed:\n  %s' % (dst, res[0]['data'])
                return 2

    res = P4Run('resolve -at ...')  #autoresolve in P4 accepting all the new files instead of merging
    if Debug:
        print '  p4 resolve : %s' % res[0]
    # no error checking. there may be nothing to resolve

    # revert unchanged files
    res = P4Run('revert -a -c %i ...' % changelist)
    if Debug:
        print '  p4 resolve : %s' % res[0]

    # see whether any files left in the changelist
    res = P4Run('describe %i' % changelist)
    if res[0]['code'] == 'stat' and not res[0].has_key('depotFile0'):
        print 'Nothing to submit...'
        P4Run('change -d %i' % changelist)
        return 0

    if Submit:
        print '  submitting changelist %i' % changelist
        res = P4Run(r'submit -c %i' % changelist)
        if Debug:
            pprint(res)
        for r in res:
            if r['code'] == 'error':
                print 'Submitting failed:\n  %s' % (r['data'], )
                return 2

