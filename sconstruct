def Builder_GameData(shouldDif):
   
    print ' '
    print '============================================='    
    print '%s Builder_GameData called' % Language
    print '============================================='    
    
    ret = 0
    
    print r'About to cleanup Folder: %s' % BackupRoot
    # prepare the language assets
    if os.path.exists(BackupRoot):
        CleanupFolder(BackupRoot)
    print r'Completed cleanup Folder: %s' % BackupRoot

    assets = None

    try:
        print 'About to copy language assets'
        assets = CopyLanguageAssets()
        print 'Completed copy language assets'

        # build localized pack files
        print 'About to build localized pack files'
        ret = PacksLocalized()
        print 'Completed build localized pack files'
        
        # ideally would like to have Builder_GameDiff as a seperate builder that follows Builder_GameData, 
        # while this works fine for the files in FoldersToDiffLoc fmvs will be in a different relative path
        # compared to reference folder eg Ref: French\data\fmv  New: localization\French\data\fmv.  So rather
        # than stick a special case in the diff builder it is easier to call it now as all the assest will be
        # in the retail layout
        
        for language, folders in LocFoldersToDif:
            if language == globals()["LanguageId"]:
                if shouldDif and ret == 0:
                    ret = Builder_GameDiff(folders)
        

    except Exception, ex:
        print ex
        ret = 1

    # revert to English
    print 'About to restore language assets'
    RestoreLanguageAssets(assets)
    print 'Completed restore language assets'
    
    return ret
    
