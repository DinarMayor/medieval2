#Changes the InstallShield script, specifically GUID, root path and release version
def AdjustISM(source, root_path, release_version, productGuid):
    pguids = {  'retail':'{C0698BDA-0D29-40EE-8570-A31106DF9AB1}',
                'direct2drive':'{A9D0745C-BABD-472B-8AF0-FAF888D31046}',
                'digitalriver':'{E3B264C6-632C-4B6B-98FE-C5934A103258}',
                '':''}

    print ' '
    print '=========================================================================================================================================='
    print 'Entered AjustISM with source (%s), root_path (%s), release_version (%s), productGuid (%s)' % (source, root_path, release_version, productGuid)
    print 'Product GUID string: %s' % pguids[productGuid]
    print '=========================================================================================================================================='
    
    try:
        print 'Opening %s read only' % (source)
        f = open(source, 'r')
        print 'Opening %s%s writable' % (source, '.tmp0')
        w = open(source +'.tmp0', 'w')
        print 'Opens both succeeded'
        
        lineNum = 0
        try:
            lines = f.readlines()
        except:
            print 'Error: readlines() threw an exception on file %s' % source
            return 1
            
        for s in lines:
            findString = ''
            try:
            
                if root_path != '':
                    findString = '<row><td>ROOT_PATH</td><td>'
                    res = -1
                    try:
                        res = s.find(findString)
                    except:
                        print 'Error: find threw an exception trying to find %s in %s at line %d' % (findString, source, lineNum)
                        return 1
                                         
                    if res >= 0:
                        print 'found %s ok' % findString
                        try:
                            s = '\t\t' + findString + root_path + '</td><td/><td>2</td></row>\n'
                        except:
                            print 'Error: unable to build string for %s' % findString
                            return 1
                            
                                                    
                if release_version != '':
                    findString = '<row><td>ProductVersion</td><td>'
                    res = -1
                    try:
                        res = s.find(findString)
                    except:
                        print 'Error: find threw an exception trying to find %s in %s at line %d' % (findString, source, lineNum)
                        return 1
                                         
                    if res >= 0:
                        try:
                            s = '\t\t' + findString + release_version + '</td><td/></row>\n'
                        except:
                            print 'Error: unable to build string for %s' % findString
                            return 1
                            
                                                    
                if productGuid != '':
                    findString = '<row><td>ProductCode</td><td>'
                    res = -1
                    try:
                        res = s.find(findString)
                    except:
                        print 'Error: find threw an exception trying to find %s in %s at line %d' % (findString, source, lineNum)
                        return 1
                        
                    if res >= 0:
                        pguid = ''
                        try:
                            pguid = pguids[productGuid]
                        except:
                            print 'Error: trying to access element %d of pguids' % productGuid
                            return 1
                        
                        try:
                            s = '\t\t' + findString + pguid + '</td><td/></row>\n'            
                        except:
                            print 'Error: unable to build string for %s and %s' % (findString, pguid)
                            return 1
                        
                lineNum = lineNum + 1
                
            except:
                print 'Error: find loop threw an exception trying to find %s (%s) in %s at line %d' % (findString, s, source, lineNum)
                return 1             
                
            try:              
                w.write(s)
            except:
                print 'Error: failed to write to %s%s' % (source, '.tmp0')
                return 1
                    
                
        try: 
            w.close()
        except:
            print 'Error: failed to close to %s%s' % (source, '.tmp0')
            return 1
            
        try: 
            f.close()
        except:
            print 'Error: failed to close to %s' % (source)
            return 1
        
            
        oldSrc = source +'.old'
        if os.path.exists(oldSrc):
            os.chmod(oldSrc, 0777)     #change file attributes to make file writable
            print 'removing %s' % oldSrc
            os.remove(source +'.old')
            
        print 'renaming %s to %s' % (source, oldSrc)
        os.rename(source, source +'.old')
        
        
        if os.path.exists(source):
            os.chmod(source, 0777)     #change file attributes to make file writable
            print 'removing %s' % source
            os.remove(source)
            
        print 'renaming %s to %s' % (source +'.tmp0', source)
        os.rename(source +'.tmp0', source)
        
        print 'Root path in %s changed to <%s>' % (source,root_path)
    except:
        print 'Error: can not change %s' % source
        return 1
    return 0
    
#------------------------------------------------------------------------------
#Restores the original InstallShield script
def RestoreISM(source):
    print 'restoring original of %s' % source
    
    try:
        if os.path.exists(source):
            os.remove(source)
        os.rename(source + '.old', source)
    except:
        print 'Error: unabel to restore %s' % source
        return 1
        
    return 0

#------------------------------------------------------------------------------
#Changes the InstallShield script, specifically the distribution source
def AdjustScript(source, distribSrc):

    try:
        os.chmod(source, 0777)
        f = open(source, 'r')
        w = open(source +'.tmp0', 'w')
        for s in f.readlines():
            if distribSrc != '':
                if s.find('scriptreplaceDS') >= 0:
                    s = '    distributionSource = "' + distribSrc + '";//scriptreplaceDS\n'
            w.write(s)
        w.close()
        f.close()
        
        print 'renaming %s to %s' % (source, source +'.old')
        if os.path.exists(source +'.old'):
            os.remove(source + '.old')
        os.rename(source, source +'.old')
        
        print 'renaming %s to %s' % (source +'.tmp0', source)
        
        if os.path.exists(source):
            os.remove(source)
        os.rename(source +'.tmp0', source)
    except:
        print 'Error: can not change %s script' % source
        return 1
    return 0
    
#------------------------------------------------------------------------------
#Restores the original InstallShield script
def RestoreScript(source):
    print 'restoring original of %s' % source
    
    try:
        if os.path.exists(source):
            os.remove(source)
        os.rename(source + '.old', source)
    except:
        print 'Error: unabel to restore %s' % source
        return 1
        
    return 0

#------------------------------------------------------------------------------
#Builds InstallShield lib
def BuildISLib():
    folder = os.getcwd()
    os.chdir(r'.\installers\islib')
    EnsureFolder(r'.\lib')
    # compile
    opt =  r'-c -i".\inc"'
    for s in ISIncludes:
        opt += r' -i"%s"' % os.path.join(ISRoot,s)
    for s in os.listdir(r'.\src'):
        if os.path.splitext(s)[1] == '.rul':
            cmd = r'"%s" .\src\%s %s' % (ISCompiler, s, opt)
            res = env.Execute(cmd)
            if res != 0:
                os.chdir(folder)
                return res
    # link
    cmd = r'"%s"' % ISCompiler
    for s in os.listdir(r'.\src'):
        if os.path.splitext(s)[1] == '.obs':
            cmd += r' .\src\%s' % s
    cmd += r' -l -o".\lib\islib.obl"'
    res = env.Execute(cmd)
    if res != 0:
        os.chdir(folder)
        return res

    os.chdir(folder)
    return 0

