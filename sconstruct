def NLBuilder_GameData(args):

    print ' '
    print '============================================='   
    print 'NLBuilder_GameData called'
    print '============================================='     
    
    #verify the blocks
    ret = CheckBlocks()
    if ret:
        return ret
    
    #do a data convert but don't populate cache
    ret = DataConvert(LowQuality)
    if ret:
        return ret
    
    #builds non-localised game packs (anims and rwm fils) by running the game (ie not sounds or strings as these are localised)
    ret = PacksGame()
    if ret:
        return ret
        
    #creates *.pack files but excludes sounds, anims and text
    ret = PacksPacker()
    if ret:
        return ret
        
    return 0
   
