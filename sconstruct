#------------------------------------------------------------------------------
#By the time this called, code has been built (debug, release, release_rd, retail game, and release and debug tools, and unpacker and launcher)
def CreateKingdomsSKU():
   
    startMark = time.clock()

    #find SKU's index for use with the parrellel arrays
    found    = 0
    for SKULang in SKULanguages:
        if SKULang[0] != SKUName and not found:
            globals()["SKUIndex"] = SKUIndex + 1
        else:
            found = 1

    if not found:
        print 'Could not find SKU %s' % SKUName
        return 1

        
    #retrieve the various arrays
    languages       = SKULanguages[globals()["SKUIndex"]][1]
    preBuilders     = SKUPreBuilders[globals()["SKUIndex"]][1]
    builders        = SKUBuilders[globals()["SKUIndex"]][1]
    postBuilders    = SKUPostBuilders[globals()["SKUIndex"]][1]
    installerKeys   = SKUInstallerKeys[globals()["SKUIndex"]][1]
    
    
    #are we permitted to run the pre-builders and builders? ie SKUPostBuildOnly is not set to true
    if not SKUPostBuildOnly:
        #preBuilders to build the non-localised game
        for preBuilder in preBuilders:
            ret = preBuilder[0](preBuilder[1])
            if ret:
                return ret
            
        
        #localisation build and post build
        for language in languages:
            globals()["LanguageId"] = language
            
            # if the language is english then the global variable 'Language' must be set to 'None' 
            # as there is no localisation data for english
            if language == 'English':
                globals()["Language"] = None
            else:
                globals()["Language"] = language
        
            for builder in builders:
                ret = builder[0](builder[1]) or ret   
                
        if ret != 0:
            return ret 
            
    else:
        print 'SKUPostBuildOnly set, skipping prebuilders and builders'
                  
        
    #are the post builders disabled?
    if not SKUNoPostBuild:
        
        for code_and_source in SKUInstallerKeys[globals()["SKUIndex"]][1]:
    
            #stash product code and dist src globally
            globals()["ProductCode"]   = code_and_source[0]
            globals()["DistribSource"] = code_and_source[1]
        
            #build installers/launchers
            for postBuilder in postBuilders:
                ret = postBuilder[0](postBuilder[1])
                if ret:
                    return ret
            

    endMark = time.clock()                    
    
    elapsedTime = (endMark - startMark) / 60.0
    
    print ''
    print '------------------------------------------------------------------------------------------------'
    print 'Kingdoms Creation took %f minutes' % elapsedTime
                                        
    return 0
    
