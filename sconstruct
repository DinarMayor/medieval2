#SkipBlockCheck is just so the build doesn't tank on mods that don't have settlement data (set in Luntbuild)
def CheckBlocks():
    if SkipBlockCheck:
        return 0
        
    EnsureArtifactsFolder()

    log = os.path.join(artifactsDir, 'block-checker.log.txt')

    cmd = r'%sBlockChecker --bc.projectdir=. --bc.dbintegrity --bc.exportFiles --log.to="%s" --log.level="* info"' % (toolsPath, log)
    res = env.Execute(cmd)

    # save the log
    if Log2HTML(log, os.path.join(artifactsDir, 'block-checker-log.html'), DataLogFormatting) and FailOnBadBlocks :
        res = 1

    return res

