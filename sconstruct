def NLBuilder_ModData(modDirs):

    print ' '
    print '============================================='   
    print 'NLBuilder_ModData called'
    print '=============================================' 
        
    #flag as mod build
    globals()["ModBuild"] = 1
    
    #iterate over the mod directories
    for modDir in modDirs:
        globals()["modPath"]         = modDir
        globals()["modName"]         = modPath.replace('\\', '-')
        globals()["modArtifactsDir"] = os.path.join(artifactsDir, modPath)
        
        #ensure artifacts present
        EnsureArtifactsFolder()

        #verify the blocks                
        ret = CheckBlocks_Mod()
        if ret:
           return ret
    
        #do a mod data convert but don't populate cache
        ret = DataConvert_Mod(LowQuality)
        if ret:
            globals()["ModBuild"] = 0
            return ret
        
        #builds non-localised mod packs (anims and rwm fils) by running the game (ie not sounds or strings as these are localised)
        ret = PacksGame_Mod()
        if ret:
            globals()["ModBuild"] = 0
            return ret
            
        #creates *.pack files for the mod but excludes sounds, anims and text
        ret = PacksPacker_Mod()
        if ret:
            globals()["ModBuild"] = 0
            return ret
        
    globals()["ModBuild"] = 0
    
    return 0
    
