#Generates animation packs and rwm files by running the release version of the game (but not sound or game packs).
def PacksGame():

    log_file = os.path.join(artifactsDir, 'game-packs.log.txt')

    if DemoBuild:
        exe = r'%sjam.exe demo dds' % gamePath
        res = env.Execute(exe)
    else:
        exe = r'%sjam.exe dds' % gamePath
        res = env.Execute(exe)

    exe = r'%s%s' % (gamePath, globals()["SKUExe"])
    cmd = exe + r' --video.windowed --core.disable_dialogs ' + \
            '--audio.disabled ' + \
            '--util.animdb --util.rwm --io.filtered=nofilter ' + \
            '--log.to='+log_file+' --log.level="* trace" '
    res = env.Execute(cmd)

    if DemoBuild:
        cmd = exe + r' --video.windowed --core.disable_dialogs ' + \
            '--io.filtered=nofilter --misc.quit_on_start --debug.bypass_to_battle=custom/pavia ' + \
            '--log.to='+log_file+' --log.level="* trace" '
        env.Execute(cmd)
    
    # save the log
    if Log2HTML(log_file, os.path.join(artifactsDir, 'game-packs.log.html'), DataLogFormatting):
        res = 1

    return res

