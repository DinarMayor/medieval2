#Diffs are output to Diffs\Patch then purged (diffs are only intermediate files used to build the installer)    
def CreateRetailUpdate2Diff():

    EnsureArtifactsFolder()
         
    # setup destination diff folder
    targetDir = os.path.join(os.getcwd(), r'Diffs\Patch')
    
    # remove any existing diffs
    shutil.rmtree(targetDir, True)
    
    # create the folder
    EnsureFolder(targetDir)

    #diff the folders
    for fld, opt in FoldersToDiff:
        res = CreateDiffs(targetDir, fld, opt)
        if res != 0:
            return res
    
    return 0

#------------------------------------------------------------------------------
#targetDir = output dir
#folder    = one of FoldersToDiff
#options   = command line args to pass when launching patchbuilder
def CreateDiffs(targetDir, folder, options):
    niceFolderName = folder.replace('\\', '_')      #clean names for log files
    newPath = os.path.join(os.getcwd(), folder)
    oldPath = os.path.join(ReferenceVersion, "%s\%s" % (LanguageId, folder)) #ReferenceVersion set but luntbuild builder params, so a 1.1 to 1.3 patch would pass in 1.0
    outputPath = os.path.join(targetDir, folder)
    
    EnsureFolder(outputPath)
    
    log = os.path.join(artifactsDir, 'build-patch-%s-%s.log.txt' % (niceFolderName, LanguageId))
    
    cmd = r'%spatchbuilder -v %s -s "%s" "%s" "%s" >"%s"' % (toolsPath, options, outputPath, newPath, oldPath, log)
    res = env.Execute(cmd)
    
    if res != 0:
        return res
    
    return 0

