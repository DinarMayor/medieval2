#SKU Utilities   
#------------------------------------------------------------------------------

def CopyDirectory(source, destination):

    print ' '
    print '============================================='   
    print 'CopyDirectory [%s] to [%s]' % (source, destination)
    print '=============================================' 
    
    # recursive file copy (shutil.copytree will fail if destination exists)
    for root, dirs, files in os.walk(source):
        for file in files:
            relative_root = root[len(source)+1:]
            src = os.path.join(root, file)
            ddr = os.path.join(destination, relative_root)
            dst = os.path.join(ddr, file)
            
            # copy will fail if it is a new sub folder
            if not os.path.exists(ddr):
                print 'making %s' % ddr
                os.makedirs(ddr)
            
            CopyFile(src, dst)   
        
    return 0
    
#------------------------------------------------------------------------------    
    
def CopyFile(source, destination):    
    
    if os.path.exists(source):
        try:
            shutil.copyfile(source, destination)
        except IOError, e:
            print 'cannot copy %s to %s' % (source, destination)
    
#------------------------------------------------------------------------------    
    
def MoveDirectory(source, destination):

    # WILL FAIL IF DESTINATION EXISTS

    print ' '
    print '============================================='   
    print 'MoveDirectory [%s] to [%s]' % (source, destination)
    print '=============================================' 
    
        
    if os.path.exists(source):
        print 'renaming %s to %s' % (source, destination)
        os.renames(source, destination)
        return 0
    else:
        print 'MoveDirectory failed, source (%s) does not exist' % (source)
        return 1
        
    
        
