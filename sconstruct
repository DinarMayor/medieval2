#------------------------------------------------------------------------------
#Generates command to build a specified config.  Prefix [?], sln [tools.sln, medieval2.sln, launcher.sln etc], 
#configs are visual studio configs [debug, release, retail etc], projects optional [builds selected vcprojs in sln] <- useful as not 
#all projects in tools can be built with the same confg (eg release-dll)
def GenerateSolutionTargets(prefix, sln, configs, projects = []):
            
    targets = []
    for cfg in configs:
        if projects:
            for p in projects:
                tgt = env.Solution('%s-%s-%s' % (prefix, cfg, p), sln, Config='%s' % cfg, Project=p)
                env.AlwaysBuild(tgt)
                targets.append(tgt)
        else:
            tgt = env.Solution('%s-%s' % (prefix, cfg), sln, Config='%s' % cfg, Project=0)
            env.AlwaysBuild(tgt)
            targets.append(tgt)
    return targets

#------------------------------------------------------------------------------

def SaveBuildArtifacts(target, source, env):

    print ' '
    print '============================================='
    print r'SaveBuildArtifacts called, copying bin to %s\binaries' % artifactsDir
    print '=============================================' 
    
    print "  copying bin folder"
    folder = os.path.join(artifactsDir, 'binaries')
    if os.path.exists(folder):
        shutil.rmtree(folder)
    shutil.copytree(r'.\bin', folder)
    
    reArtifact = re.compile(r'^(?:medieval2|kingdoms).*\.(?:map|pdb)$', re.IGNORECASE)
    for root, dirs, files in os.walk(r'.\obj'):
        for f in files:
            if reArtifact.match(f):
                print "  copying %s" % f
                fn = os.path.join(root, f)
                shutil.copyfile(fn, os.path.join(folder, f))


