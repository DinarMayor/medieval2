    #    os.chmod(os.path.join(targetDir, 'Launch.ini'),stat.S_IWRITE)
    #    os.remove(os.path.join(targetDir, 'Launch.ini'))
    #    f = open(os.path.join(srcDir, 'Launch.ini'), 'r')
    #    w = open(os.path.join(targetDir, 'Launch.ini'), 'w')
    #    for s in f.readlines():
    #        if s.find('CmdLine=-q') >= 0:
    #            s = 'CmdLine=-q -L' + langId[language] + '\n'
    #        w.write(s)
    #    w.close()
    #    f.close()
    #    print 'Done.'

    return 0

